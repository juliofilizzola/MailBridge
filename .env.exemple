# api | worker | all
APP_ROLE=all
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
SQS_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/mail-bridge-local-queue
SQS_DLQ_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/mail-bridge-local-dlq
AWS_ACCESS_KEY_ID=teste-local
AWS_SECRET_ACCESS_KEY=teste-local

# Retry (backoff exponencial: base * 2^(tentativa-1), limitado ao max)
MAX_RECEIVE_ATTEMPTS=5
RETRY_BASE_DELAY_SECONDS=30
RETRY_MAX_DELAY_SECONDS=900

# API HTTP (chaves separadas por vírgula)
API_PORT=3000
API_KEYS=chave_local_1,chave_local_2
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Providers (só os configurados são registrados)
SMTP_SERVER=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=usuario_teste_smtp
SMTP_PASSWORD=senha_teste_smtp
SENDGRID_API_KEY=SG.chave_falsa_exemplo_sendgrid
GMAIL_USER=
# Gmail via senha de app...
GMAIL_APP_PASSWORD=
# ...ou via OAuth2 (tem prioridade quando os três estão preenchidos)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
